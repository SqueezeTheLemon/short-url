# `cp .env.example .env` 로 복사해서 써요. .env 는 git에 올라가지 않아요.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/short_url
PORT=3000
# 사용자가 접속하는 공개 주소(Cloudflare Worker). 자기 자신을 단축하는 걸 막을 때 써요(티켓 04).
PUBLIC_ORIGIN=http://localhost:3000
# 로컬에서 백엔드 하나로 화면까지 서빙하고 싶을 때만: dx build 산출물 폴더
# STATIC_DIR=target/dx/frontend/release/web/public
